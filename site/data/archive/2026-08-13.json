2ef-9d9b-ef7977dd5015.gif\" w=\"1079\" h=\"607\" data-vmark=\"cb68\" data-preview=\"https://img.ithome.com/newsuploadfiles/2026/8/bc6c654b-f4fe-42ef-9d9b-ef7977dd5015.gif?x-bce-process=image/format,f_png\" data-advance=\"W3siVHlwZSI6IndlYnBhIiwiVXJsIjoiaHR0cHM6Ly9pbWcuaXRob21lLmNvbS9uZXdzdXBsb2FkZmlsZXMvMjAyNi84LzhkNGE2YTBiLTVjYmEtNGQxNC1iZGRkLWQ4NDE4YTk3NjA2Yi53ZWJwIn1d\"></p><p data-vmark=\"c000\">因硬件性能限制，「柔光玻璃」材质、交互光效等，将适配：</p><ul class=\" list-paddingleft-2\"><li><p data-vmark=\"9780\">搭载骁龙 8 至尊版移动平台及以上的手机和平板产品</p></li><li><p data-vmark=\"6988\">搭载天玑 9500 旗舰移动平台及以上的手机产品</p></li><li><p data-vmark=\"d998\">搭载玄戒 O1 3nm 旗舰处理器及以上的手机产品</p></li></ul><h3 data-vmark=\"f3f7\">新锁屏：一站式调节，一口气完成个性化设置</h3><p data-vmark=\"203f\" style=\"text-align: center;\"><img src=\"https://img.ithome.com/newsuploadfiles/2026/8/d6f94df2-2373-4ad4-bd59-6c3c3681e571.gif\" w=\"1080\" h=\"608\" data-vmark=\"303e\" data-preview=\"https://img.ithome.com/newsuploadfiles/2026/8/d6f94df2-2373-4ad4-bd59-6c3c3681e571.gif?x-bce-process=image/format,f_png\" data-advance=\"W3siVHlwZSI6IndlYnBhIiwiVXJsIjoiaHR0cHM6Ly9pbWcuaXRob21lLmNvbS9uZXdzdXBsb2FkZmlsZXMvMjAyNi84Lzk0MWQyY2E1LTI5NTEtNDcxNi1iOTk2LTA3OTZhZjVkZjZmOC53ZWJwIn1d\"></p><p data-vmark=\"2be4\" style=\"text-align: center;\"><img src=\"https://img.ithome.com/newsuploadfiles/2026/8/30c3bbac-b26d-48dd-bd83-5b42879a7eb3.png\" w=\"1080\" h=\"608\" data-vmark=\"cf08\"></p><h3 data-vmark=\"a6dc\">新桌面：更丰富的桌面元素，支持小部件堆叠、文件夹自由调节</h3><p data-vmark=\"9389\" style=\"text-align: center;\"><img src=\"https://img.ithome.com/newsuploadfiles/2026/8/f73fd2cd-b5b5-40ca-b2d2-98abc0d29e07.png\" w=\"1080\" h=\"608\" data-vmark=\"9e90\"></p><p data-vmark=\"2344\" style=\"text-align: center;\"><img src=\"https://img.ithome.com/newsuploadfiles/2026/8/94626cda-9095-43c1-81cf-78ea80e8eab6.gif\" w=\"1080\" h=\"608\" data-vmark=\"40d1\" data-preview=\"https://img.ithome.com/newsuploadfiles/2026/8/94626cda-9095-43c1-81cf-78ea80e8eab6.gif?x-bce-process=image/format,f_png\" data-ad